      "description": "Temporary seat hold, seat reservation confirmation, and automatic background expiration endpoints.",
      "item": [
        {
          "name": "Create Temporary Seat Hold",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Seat hold status is PENDING', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('PENDING');",
                  "    pm.environment.set('holdId', jsonData.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"eventId\": {{eventId}},\n  \"numberOfSeats\": 3,\n  \"price\": 999.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings/hold?expirationSeconds=60",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "hold"],
              "query": [
                {
                  "key": "expirationSeconds",
                  "value": "60"
                }
              ]
            }
          }
        },
        {
          "name": "Confirm Seat Hold",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Seat hold confirmed successfully', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('CONFIRMED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{holdId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{holdId}}", "confirm"]
            }
          }
        },
        {
          "name": "Create Short 3-Sec Hold for Automatic Expiration Test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Short seat hold created (expires in 3 sec)', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('PENDING');",
                  "    pm.environment.set('shortHoldId', jsonData.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"eventId\": {{eventId}},\n  \"numberOfSeats\": 2,\n  \"price\": 999.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings/hold?expirationSeconds=3",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "hold"],
              "query": [
                {
                  "key": "expirationSeconds",
                  "value": "3"
                }
              ]
            }
          }
        },
        {
          "name": "Verify Expired Hold Status (Run after 5 sec delay)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Hold automatically expired by background scheduler', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('EXPIRED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{shortHoldId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{shortHoldId}}"]
            }
          }
        }
      ]
    },
