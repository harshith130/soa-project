# ============================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ============================================================
# Copy this file to .env and fill in with your actual values
# DO NOT commit .env to version control
# ============================================================

# ============================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================

# Render PostgreSQL Connection URL
# Format: jdbc:postgresql://[host]:[port]/[database]
DATABASE_URL=jdbc:postgresql://localhost:5432/stagefront_user_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_password_here

# For multi-database setup (if services use separate databases):
# EVENT_DATABASE_URL=jdbc:postgresql://[render-host]:5432/stagefront_event_db
# EVENT_DATABASE_USERNAME=postgres
# EVENT_DATABASE_PASSWORD=your_secure_password_here
#
# BOOKING_DATABASE_URL=jdbc:postgresql://[render-host]:5432/stagefront_booking_db
# BOOKING_DATABASE_USERNAME=postgres
# BOOKING_DATABASE_PASSWORD=your_secure_password_here

# ============================================================
# SERVICE DISCOVERY & COMMUNICATION (Eureka)
# ============================================================

# Eureka Server URL - Set to Eureka service instance on Render
# Format: http://[eureka-service-url]/eureka/
# For local development: http://localhost:8761/eureka/
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# User Service URL - If not using Eureka discovery (Render with direct service URLs)
# For Eureka discovery: http://user-service (logical name)
# For direct URL: http://[render-user-service-url]:[port]
USER_SERVICE_URL=http://user-service

# ============================================================
# API GATEWAY & FRONTEND CONFIGURATION
# ============================================================

# Frontend API Base URL (for VITE_API_BASE_URL in frontend build)
# Development: http://localhost:8080
# Production (Render): https://api-gateway-service-url.onrender.com
VITE_API_BASE_URL=http://localhost:8080

# API Gateway CORS Allowed Origins (comma-separated, no spaces)
# Development: http://localhost:3000,http://localhost:5173
# Production: https://stagefront.vercel.app,https://www.stagefront-app.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================
# PORT CONFIGURATION
# ============================================================

# Individual service ports (optional, defaults provided in application.properties)
# PORT=8080

# ============================================================
# USER SERVICE EMAIL CONFIGURATION (Legacy Migration)
# ============================================================
# For password reset and email notifications (if implemented)
USER_SERVICE_MIGRATION_EMAIL=
USER_SERVICE_MIGRATION_PASSWORD=

# ============================================================
# AUTHENTICATION & JWT (Future Enhancement)
# ============================================================
# JWT_SECRET=your_jwt_secret_key_here_min_32_chars
# JWT_EXPIRATION_HOURS=24

# ============================================================
# MAIL SERVER CONFIGURATION (Future Enhancement)
# ============================================================
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=your_app_password

# ============================================================
# APPLICATION SETTINGS
# ============================================================
# SPRING_PROFILES_ACTIVE=dev
# LOG_LEVEL=INFO

# ============================================================
# RENDER DEPLOYMENT NOTES
# ============================================================
# When deploying to Render:
# 
# 1. For services that require DATABASE_URL:
#    - User Service: Uses DATABASE_URL
#    - Event Service: Uses DATABASE_URL
#    - Booking Service: Uses DATABASE_URL
#
# 2. For Eureka Server:
#    - Set EUREKA_SERVER_URL to the Eureka service URL
#    - Set eureka.client.register-with-eureka=false for server itself
#
# 3. For API Gateway:
#    - Set EUREKA_SERVER_URL to discover backend services
#    - Set CORS_ALLOWED_ORIGINS to allow frontend URLs
#    - Set VITE_API_BASE_URL for frontend to use
#
# 4. For PostgreSQL on Render:
#    - Create a PostgreSQL database instance
#    - Copy the External Database URL from Render console
#    - Set DATABASE_URL to the PostgreSQL instance URL

